  m_Script: {fileID: 11500000, guid: 5e9fa9badb6e7fa468f718979686bf5a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionRange: 3
  interactKey: 101
  cryingChild: {fileID: 0}
  dialogoVacilar1: "\xBFQui\xE9n eres t\xFA? \xA1No me f\xEDo de ti! \xBFD\xF3nde
    est\xE1 mi hijo?"
  dialogoVacilar2: "\xBFVienes sin mi hijo y quieres que te ayude? Ja, buena suerte
    ah\xED fuera, listo."
  dialogoVacilar3: "Tr\xE1eme a mi hijo y entonces hablamos. Hasta entonces... pi\xE9rdete."
  dialogoConHijo1: "\xA1Mi hijo! \xA1Gracias, gracias! No s\xE9 c\xF3mo agradec\xE9rtelo..."
  dialogoConHijo2: "Escucha, te voy a decir c\xF3mo salir de aqu\xED. Presta atenci\xF3n:"
  dialogoPista1: 'Primero: busca el juego de Simon en el campamento militar.'
  dialogoPista2: "Segundo: consigue acceso al avi\xF3n del hangar."
  dialogoPista3: "Tercero: sube al avi\xF3n y escapa. Es tu \xFAnica salida."
  dialogoFinal: Buena suerte, amigo. Y... gracias por traer a mi hijo.
  dialogoYaDioPistas: "Ya te lo dije todo. Busca el juego, coge el avi\xF3n y escapa.
    \xA1Vete!"
  dialogDuration: 4
  talkSound: {fileID: 0}
